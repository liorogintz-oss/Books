rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A library is reachable only by its long random code (from the invite link).
    // Nobody can list libraries, so the code acts as the family's key.
    match /libraries/{lib} {
      allow get: if true;
      allow list: if false;
      allow create: if lib.size() >= 12 && lib.matches('^[a-z0-9]+$');
      allow update, delete: if false;

      match /books/{book} {
        allow read, write: if exists(/databases/$(database)/documents/libraries/$(lib));
      }
    }

    // Teaching-practicum journals (practicum/). Same idea: the long random code in the link is the key.
    match /journals/{j} {
      allow get: if true;
      allow list: if false;
      allow create: if j.size() >= 12 && j.matches('^[a-z0-9]+$');
      allow update: if request.resource.data.keys().hasOnly(['profile', 'createdAt']);
      allow delete: if false;

      match /days/{day} {
        allow read, write: if exists(/databases/$(database)/documents/journals/$(j));
      }
      match /photos/{day} {
        allow read, write: if exists(/databases/$(database)/documents/journals/$(j));
      }
    }
  }
}
